{
  "name": "scanproof",
  "description": "QR code scannability audit layer on top of node-qrcode: dual-decoder verification, spec gates, degradation variants, and verified fixes",
  "version": "2.0.0",
  "author": "Ryan Day <soldair@gmail.com>",
  "contributors": [
    "Vincenzo Greco <greco.vincenzo@gmail.com>",
    "Linus Unnebäck <linus@folkdatorn.se>"
  ],
  "keywords": [
    "qr",
    "qrcode",
    "scannability",
    "audit",
    "accessibility",
    "print",
    "wcag",
    "decoder"
  ],
  "main": "./lib/index.js",
  "browser": {
    "./lib/index.js": "./lib/browser.js",
    "fs": false
  },
  "files": [
    "bin",
    "build",
    "lib",
    "helper",
    "docs",
    "demo"
  ],
  "homepage": "https://github.com/llinok111/scanproof",
  "license": "MIT",
  "scripts": {
    "lint": "standard",
    "test": "node test/run-tests.js \"test/**/*.test.js\"",
    "test:upstream": "node test/run-tests.js \"test/unit/**/*.test.js\" \"test/e2e/**/*.test.js\"",
    "test:scanproof": "node test/run-tests.js \"test/scanproof/*.test.js\"",
    "build": "rollup -c && node scripts/build-demo.js",
    "measure": "node scripts/measure.js",
    "verify:demo": "node scripts/verify-demo.mjs",
    "probe:layout": "node scripts/probe-layout.mjs"
  },
  "bin": {
    "qrcode": "./bin/qrcode",
    "qr-scanproof": "./bin/qr-scanproof"
  },
  "dependencies": {
    "dijkstrajs": "^1.0.1",
    "pngjs": "^5.0.0",
    "yargs": "^15.3.1"
  },
  "optionalDependencies": {
    "@zxing/library": "^0.21.3",
    "jsqr": "^1.4.0"
  },
  "devDependencies": {
    "@babel/core": "^7.9.0",
    "@babel/preset-env": "^7.9.5",
    "@rollup/plugin-commonjs": "^11.1.0",
    "@rollup/plugin-node-resolve": "^7.1.3",
    "browserify": "^16.5.1",
    "canvas": "^2.8.0",
    "canvasutil": "0.0.4",
    "colors": "^1.4.0",
    "express": "^4.17.1",
    "htmlparser2": "^4.1.0",
    "rollup": "^2.6.1",
    "rollup-plugin-babel": "^4.4.0",
    "rollup-plugin-terser": "^5.3.0",
    "sinon": "^9.0.2",
    "standard": "^16.0.4",
    "tap": "^16.2.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/llinok111/scanproof.git"
  },
  "engines": {
    "node": ">=14"
  },
  "standard": {
    "ignore": [
      "build/",
      "demo/scanproof.bundle.js",
      "examples/vendors/",
      "lib/core/regex.js"
    ]
  }
}
